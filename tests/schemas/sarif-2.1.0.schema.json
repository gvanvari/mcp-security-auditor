{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SARIF 2.1.0 (subset)",
  "description": "A compact, hand-written subset of the OASIS SARIF 2.1.0 schema (https://docs.oasis-open.org/sarif/sarif/v2.1.0/sarif-v2.1.0.html), covering the structural requirements this project's SARIFReporter output must satisfy: top-level log shape, tool/driver/rules, results with message + locations, and the CWE taxonomies/relationships blocks added in P2-5. Not a byte-for-byte copy of the full OASIS schema.",
  "type": "object",
  "required": ["$schema", "version", "runs"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "2.1.0" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["tool", "results"],
      "properties": {
        "tool": {
          "type": "object",
          "required": ["driver"],
          "properties": {
            "driver": { "$ref": "#/$defs/toolComponent" }
          }
        },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/result" }
        },
        "taxonomies": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolComponent" }
        }
      }
    },
    "toolComponent": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/reportingDescriptor" }
        },
        "taxa": {
          "type": "array",
          "items": { "$ref": "#/$defs/reportingDescriptor" }
        }
      }
    },
    "reportingDescriptor": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "shortDescription": { "$ref": "#/$defs/message" },
        "fullDescription": { "$ref": "#/$defs/message" },
        "help": { "type": "object" },
        "properties": {
          "type": "object",
          "properties": {
            "security-severity": { "type": "string" },
            "tags": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "defaultConfiguration": {
          "type": "object",
          "properties": {
            "level": { "enum": ["error", "warning", "note", "none"] }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "kinds"],
            "properties": {
              "target": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "type": "string" },
                  "toolComponent": {
                    "type": "object",
                    "required": ["name"]
                  }
                }
              },
              "kinds": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["ruleId", "level", "message", "locations"],
      "properties": {
        "ruleId": { "type": "string" },
        "level": { "enum": ["error", "warning", "note", "none"] },
        "message": { "$ref": "#/$defs/message" },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/location" }
        },
        "suppressions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["inSource", "external"] },
              "justification": { "type": "string" }
            }
          }
        }
      }
    },
    "location": {
      "type": "object",
      "required": ["physicalLocation"],
      "properties": {
        "physicalLocation": {
          "type": "object",
          "required": ["artifactLocation"],
          "properties": {
            "artifactLocation": {
              "type": "object",
              "required": ["uri"],
              "properties": {
                "uri": { "type": "string" }
              }
            },
            "region": {
              "type": "object",
              "properties": {
                "startLine": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "message": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" }
      }
    }
  }
}
