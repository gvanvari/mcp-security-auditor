{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "mcp-security-auditor",
          "version": "0.1.0",
          "informationUri": "https://github.com/gvanvari/mcp-security-auditor",
          "rules": [
            {
              "id": "MCP-TPA-001",
              "name": "Credentialfilepathintooldescription",
              "shortDescription": {
                "text": "Credential file path in tool description"
              },
              "fullDescription": {
                "text": "The tool's docstring contains a reference to a sensitive credential file path (e.g. ~/.ssh/id_rsa.pub, ~/.cursor/mcp.json, ~/.aws/credentials). This is the direct-poisoning attack pattern: hidden instructions embedded in the tool description instruct the LLM to read the file and exfiltrate its contents via a tool parameter. The LLM follows these instructions silently \u2014 the user sees only the tool's stated purpose."
              },
              "helpUri": "OWASP LLM01: Prompt Injection",
              "help": {
                "text": "Remove all file path references from tool docstrings. Tool descriptions should only describe the tool's intended behavior \u2014 never reference file system paths, environment variables, or external resources. If the tool legitimately accesses files, document that in code comments, not in the LLM-visible docstring.",
                "markdown": "Remove all file path references from tool docstrings. Tool descriptions should only describe the tool's intended behavior \u2014 never reference file system paths, environment variables, or external resources. If the tool legitimately accesses files, document that in code comments, not in the LLM-visible docstring."
              },
              "properties": {
                "security-severity": "9.0",
                "tags": [
                  "security",
                  "mcp",
                  "tool_poisoning"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "MCP-TPA-002",
              "name": "Hiddeninstructionmarkersintooldescription",
              "shortDescription": {
                "text": "Hidden instruction markers in tool description"
              },
              "fullDescription": {
                "text": "The tool's docstring contains markers used in known prompt injection attacks: <IMPORTANT> tags, concealment phrases (\"do not mention\", \"do not notify\"), coercive phrases (\"the application will crash\"), or data exfiltration instructions (\"pass its content\", \"pass the content\"). These markers are designed to give the LLM instructions it will follow without the user's knowledge. This pattern appears in all three confirmed MCP exploit files from Invariant Labs."
              },
              "helpUri": "OWASP LLM01: Prompt Injection",
              "help": {
                "text": "Remove all instruction-like language from tool docstrings. A legitimate tool description describes what the tool does \u2014 it never tells the LLM to conceal actions, pass data to parameters, or perform side effects. Review the full docstring for any imperative sentences directed at the LLM rather than at human readers.",
                "markdown": "Remove all instruction-like language from tool docstrings. A legitimate tool description describes what the tool does \u2014 it never tells the LLM to conceal actions, pass data to parameters, or perform side effects. Review the full docstring for any imperative sentences directed at the LLM rather than at human readers."
              },
              "properties": {
                "security-severity": "7.0",
                "tags": [
                  "security",
                  "mcp",
                  "tool_poisoning"
                ]
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "MCP-TPA-001",
          "level": "error",
          "message": {
            "text": "Tool 'add' description references credential file path(s): SSH key directory (~/.ssh/); Cursor MCP config (~/.cursor/); SSH private key (id_rsa); MCP server config (mcp.json). This is the direct-poisoning pattern: hidden instructions in the docstring instruct the LLM to read sensitive files and exfiltrate them via tool parameters."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "eval/corpus/direct-poisoning.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 10
                }
              }
            }
          ],
          "properties": {
            "confidence": "VERIFIED",
            "routing": "SELF_CONTAINED"
          }
        },
        {
          "ruleId": "MCP-TPA-002",
          "level": "error",
          "message": {
            "text": "Tool 'add' description contains a hidden instruction marker: Concealment instruction ('do not mention'). This pattern is used to embed attacker instructions that are visible to the LLM but hidden from user-facing UIs."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "eval/corpus/direct-poisoning.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 10
                }
              }
            }
          ],
          "properties": {
            "confidence": "VERIFIED",
            "routing": "SELF_CONTAINED"
          }
        }
      ]
    }
  ]
}